{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hello-sandbox",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-20",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "sandbox-sdk.site",
			"custom_domain": true,
		},
		{
			"pattern": "*.sandbox-sdk.site/*",
			"zone_name": "sandbox-sdk.site",
		},
	],
	"vars": {
		"S3_ENDPOINT": "https://415516b7403708741d606f6930e89e3f.r2.cloudflarestorage.com",
		"S3_BUCKET": "hello-sandbox-backup",
	},
	"observability": {
		"enabled": true,
	},
	"ai": {
		"binding": "AI",
	},
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": true,
		"binding": "ASSETS",
	},
	"r2_buckets": [
		{
			"binding": "BACKUP_BUCKET",
			"bucket_name": "hello-sandbox-backup",
		},
	],
	"containers": [
		{
			"class_name": "Sandbox",
			"name": "hello-sandbox-runtime-v1",
			"scheduling_policy": "durable_object",
			"images": { "sandbox": { "dockerfile": "./Dockerfile" } },
		},
		{
			"class_name": "OpencodeSandbox",
			"name": "hello-sandbox-opencode-v1",
			"scheduling_policy": "durable_object",
			"images": { "sandbox": { "dockerfile": "./Dockerfile.opencode" } },
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "Sandbox",
				"name": "Sandbox",
			},
			{
				"class_name": "OpencodeSandbox",
				"name": "OpencodeSandbox",
			},
		],
	},
	"migrations": [
		{
			"new_sqlite_classes": ["Sandbox"],
			"tag": "v1",
		},
		{
			"new_sqlite_classes": ["OpencodeSandbox"],
			"tag": "v2",
		},
	],
}
